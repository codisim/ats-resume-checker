generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "mongodb"
}

// ======== models ========
model User {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  email              String     @unique
  password           String
  roles              UserRole[] @default([STUDENT])
  needPasswordChange Boolean    @default(true)
  isDeleted          Boolean    @default(false)

  profile UserProfile?

  notices Notice[] @relation("UserNotices")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserProfile {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  phone        String
  profilePhoto String?
  address      String?
  gender       Gender

  // ===== Teacher / Admin fields =====
  designation String?
  experience  Int?

  // ===== Student fields =====
  admissionNo   String?
  batch         String?
  monthlyFee    Int?
  admissionDate DateTime?
  status        UserStatus?

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  payments Payment[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model Notice {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String

  createdById String @db.ObjectId
  createdBy   User   @relation("UserNotices", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notices")
}

model Payment {
  id     String        @id @default(auto()) @map("_id") @db.ObjectId
  month  String
  amount Int
  status PaymentStatus
  paidAt DateTime?

  profileId String      @db.ObjectId
  profile   UserProfile @relation(fields: [profileId], references: [id])

  createdAt DateTime @default(now())

  @@map("payments")
}

model Review {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  comment String

  profileId String?
  profile   UserProfile? @relation(fields: [profileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

///////// enums /////

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ALUMNI
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}
